# Copiar a .env.local para desarrollo. En producción, todo va en Railway.
# Sin ninguna de estas, el sitio carga entero; sólo el formulario Beta contesta
# "no disponible" al enviar.

# Supabase de jlptest (esquema `ayotl`). Sólo servidor: el navegador no la ve.
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # llave secreta (antes "service_role"): SOLO servidor

# Cloudflare Turnstile (anti-spam del formulario Beta).
# La de sitio es pública por diseño y baja al navegador como prop; la secreta no.
# Claves de prueba de Cloudflare (siempre pasan):
#   TURNSTILE_SITIO=1x00000000000000000000AA
#   TURNSTILE_SECRETO=1x0000000000000000000000000000000AA
TURNSTILE_SITIO=
TURNSTILE_SECRETO=

# Aviso por correo de cada alta del programa Beta (Resend, la misma cuenta que
# jlptest). Sin la clave no se manda nada y el alta se guarda igual.
RESEND_API_KEY=
CORREO_DE=Ayotl <avisos@ayotl.dev>     # el dominio tiene que estar verificado en Resend
CORREO_AVISOS=hola@ayotl.dev           # a dónde llegan los avisos

# Panel /admin/testers. Mínimo 12 caracteres; sin esto el panel no existe.
ADMIN_SECRETO=

# Supabase de Mercadito (otra cuenta), sólo para cruzar los días de sus
# testers por teléfono. Son los mismos dos valores que tiene el servicio de
# Mercadito en Railway. Opcional: sin esto se marca a mano en el panel.
# (Se usa la API y no la conexión directa: ésa es sólo IPv6 y Railway no la
# alcanza.)
MERCADITO_SUPABASE_URL=
MERCADITO_SUPABASE_SECRET_KEY=
# Secreto del cron que cruza Mercadito. El mismo valor va en Supabase Vault
# (nunca en el comando de pg_cron, que se lee entero desde cron.job).
CRON_SECRETO=

# Dominio público, para Open Graph, sitemap y robots. Si falta, https://ayotl.dev.
NEXT_PUBLIC_SITIO=
